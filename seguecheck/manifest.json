{
   "manifest_version": 3,
   "name": "SegueCheck",
   "version": "1.0.0",
   "description": "Veja quem você segue e não te segue de volta no Instagram. Busque, filtre e revise os perfis no Chrome.",
   "action": {
      "default_title": "SegueCheck",
      "default_icon": {
         "16": "icon16.png",
         "32": "icon32.png",
         "48": "icon48.png",
         "128": "icon128.png"
      }
   },
   "background": {
      "service_worker": "background.js"
   },
   "host_permissions": [
      "https://www.instagram.com/*"
   ],
   "icons": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
   },
   "permissions": [
      "scripting",
      "storage"
   ]
}
